import numpy as np

def solve_tabulation(tiempos, beneficios, horas):

    taken = []

    table = np.zeros(
        (len(tiempos) + 1, horas + 1),
        dtype=int
    )

    def fill_table():
        # Rellenar la tabla 2D
        
        if horas == 0: #caso base
            return 0
        
        for i in range(1, len(tiempos) + 1):
            for c in range(1, horas + 1):
                
                no_fabricarse = table[i - 1][c]
                
                if tiempos[i - 1] <= c:
                    fabricarse = table[i - 1][c - tiempos[i - 1]] + beneficios[i - 1]
                    table[i][c] = max(fabricarse, no_fabricarse)
                else:
                    table[i][c] = no_fabricarse
        print(table)
        return table[i][c]

    def fill_taken():

        i = len(tiempos) 
        c = horas
       
        while i >= 0:
           
            if table[i - 1][c] == table[i][c]:
                i -= 1
            else:
                i -= 1
                taken.append(i + 1)
                c -= tiempos[i]
        taken.reverse()
        return taken


    fill_table()
    fill_taken()

    return int(table[-1][-1]), taken
